# ============================================================
# UniFi Access Manager – Environment Configuration
# Copy to `.env` and adjust values before starting the stack.
# Never commit the real `.env` file.
# ============================================================

# --- Application -------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_NAME="UniFi Access Manager"
APP_URL=https://localhost:8443

# Random secret used for session signing and encrypting API tokens.
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=unifi_access
DB_USERNAME=unifi
DB_PASSWORD=change-me

# --- Session / Security -----------------------------------------
SESSION_LIFETIME=1440
SESSION_NAME=uam_session

# --- UniFi API (global defaults) --------------------------------
# When true, the application runs against the built-in mock API
# client instead of a real UniFi Access controller. Useful for
# local development, demos and tests.
UNIFI_API_MOCK=true

# --- Initial admin account (used only by the seeder) ------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# --- Active Directory / LDAP ------------------------------------
# Synchronises AD users (RFID card number from LDAP_CARD_ATTRIBUTE)
# and maps AD groups to UniFi Access groups.
#
# Set LDAP_MOCK=true to use the built-in demo AD data instead of a
# real directory (useful for local development and tests).
LDAP_MOCK=true
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-uam,OU=ServiceAccounts,DC=example,DC=com
# Plaintext bind password (LDAP_BIND_PASSWORD_ENC takes precedence).
LDAP_BIND_PASSWORD=
# Encrypted bind password. Generate with:
#   php bin/cli.php encrypt:secret <wert>
LDAP_BIND_PASSWORD_ENC=
LDAP_USE_TLS=false
# LDAP attribute that holds the RFID card number (default: employeeID).
LDAP_CARD_ATTRIBUTE=employeeID
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_GROUP_FILTER=(objectClass=group)
# Optional separate search base for groups (defaults to LDAP_BASE_DN).
LDAP_GROUP_BASE_DN=
